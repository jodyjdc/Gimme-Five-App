@import "tailwindcss";

@source "./*.tsx";
@source "./components/**/*.tsx";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  /* Font dei testi grandi. Variante A provata e scartata: "Big Shoulders Display" (Google Fonts). */
  --font-display: var(--font-sans);
  --animate-float-slow: float 6s ease-in-out infinite;
  --animate-float-fast: float 5s ease-in-out infinite;
  --animate-fade-in: fade-in 350ms ease-out both;

  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(3deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

@keyframes moveHorizontal {
  0% {
    transform: translateX(-50%) translateY(-10%);
  }
  50% {
    transform: translateX(50%) translateY(10%);
  }
  100% {
    transform: translateX(-50%) translateY(-10%);
  }
}

@keyframes moveInCircle {
  0% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(180deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes moveVertical {
  0% {
    transform: translateY(-50%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    transform: translateY(-50%);
  }
}

.gimme-gradient-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: linear-gradient(
    40deg,
    var(--gradient-background-start),
    var(--gradient-background-end)
  );
  pointer-events: none;
}

.gimme-gradient-background::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 50%, transparent 0%, transparent 36%, rgba(0, 0, 0, 0.48) 100%),
    linear-gradient(90deg, rgba(0, 0, 0, 0.62), transparent 28%, transparent 72%, rgba(0, 0, 0, 0.62));
}

.gimme-gradients-container {
  position: absolute;
  inset: -10%;
  width: 120%;
  height: 120%;
  filter: url(#gimme-gradient-blur) blur(38px);
  opacity: 0.26;
}

.gimme-gradient-orb,
.gimme-gradient-pointer {
  position: absolute;
  width: var(--gradient-size);
  height: var(--gradient-size);
  top: calc(50% - var(--gradient-size) / 2);
  left: calc(50% - var(--gradient-size) / 2);
  mix-blend-mode: var(--blending-value);
  border-radius: 9999px;
  transform-origin: center center;
}

.gimme-gradient-first {
  background: radial-gradient(circle at center, rgba(var(--first-color), 0.62) 0, rgba(var(--first-color), 0) 48%) no-repeat;
  animation: moveVertical 68s ease infinite;
}

.gimme-gradient-second {
  background: radial-gradient(circle at center, rgba(var(--second-color), 0.54) 0, rgba(var(--second-color), 0) 50%) no-repeat;
  transform-origin: calc(50% - 360px);
  animation: moveInCircle 56s reverse infinite;
}

.gimme-gradient-third {
  background: radial-gradient(circle at center, rgba(var(--third-color), 0.42) 0, rgba(var(--third-color), 0) 50%) no-repeat;
  transform-origin: calc(50% + 340px);
  animation: moveInCircle 96s linear infinite;
}

.gimme-gradient-fourth {
  background: radial-gradient(circle at center, rgba(var(--fourth-color), 0.5) 0, rgba(var(--fourth-color), 0) 50%) no-repeat;
  transform-origin: calc(50% - 200px);
  animation: moveHorizontal 88s ease infinite;
  opacity: 0.75;
}

.gimme-gradient-fifth {
  background: radial-gradient(circle at center, rgba(var(--fifth-color), 0.16) 0, rgba(var(--fifth-color), 0) 42%) no-repeat;
  transform-origin: calc(50% - 720px) calc(50% + 720px);
  animation: moveInCircle 68s ease infinite;
  opacity: 0.48;
}

.gimme-gradient-pointer {
  width: 100%;
  height: 100%;
  top: -50%;
  left: -50%;
  background: radial-gradient(circle at center, rgba(var(--pointer-color), 0.42) 0, rgba(var(--pointer-color), 0) 44%) no-repeat;
  opacity: 0.45;
}

/* ---------- Liquid Glass ----------
   Niente backdrop-filter: lo sfondo è già sfocato, sfocarlo di nuovo non si vede e costa GPU.
   Il vetro è fatto di trasparenze, riflesso interno, bordo iridescente e luce che segue il puntatore. */

@property --glass-x {
  syntax: "<percentage>";
  inherits: true;
  initial-value: 50%;
}

@property --glass-y {
  syntax: "<percentage>";
  inherits: true;
  initial-value: 18%;
}

.glass {
  position: relative;
  background:
    radial-gradient(circle at var(--glass-x) var(--glass-y), rgba(255, 255, 255, 0.22), transparent 42%),
    linear-gradient(160deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.025) 48%, rgba(255, 255, 255, 0.07));
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.38),
    inset 0 -1px 0 rgba(255, 255, 255, 0.06),
    inset 0 0 24px rgba(255, 255, 255, 0.04),
    0 24px 48px -24px rgba(0, 0, 0, 0.8);
  transition: --glass-x 420ms cubic-bezier(0.23, 1, 0.32, 1), --glass-y 420ms cubic-bezier(0.23, 1, 0.32, 1);
}

.glass-tint {
  background:
    radial-gradient(circle at var(--glass-x) var(--glass-y), rgba(255, 255, 255, 0.3), transparent 44%),
    linear-gradient(160deg, rgba(103, 232, 249, 0.42), rgba(34, 211, 238, 0.14) 52%, rgba(14, 116, 144, 0.32));
}

/* Bordo iridescente di 1px: gradiente conico mascherato al solo contorno. */
.glass::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1px;
  border-radius: inherit;
  background: conic-gradient(
    from 210deg,
    rgba(255, 255, 255, 0.55),
    rgba(103, 232, 249, 0.35),
    rgba(165, 180, 252, 0.3),
    rgba(249, 168, 212, 0.22),
    rgba(255, 255, 255, 0.08),
    rgba(255, 255, 255, 0.55)
  );
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  background: #000;
  font-family: var(--font-sans);
}

.app-safe-center {
  justify-content: flex-start;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
