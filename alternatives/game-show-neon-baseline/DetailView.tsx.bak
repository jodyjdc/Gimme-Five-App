import React, { useState, useEffect, useRef } from 'react';
import { AnimatePresence, motion } from 'motion/react';
import { Ranking } from '../types';
import { broadcastTransition, easeOutQuart, gameShowSpring, quickTransition, screenTransition, spotlightTransition } from '../motionConfig';

interface DetailViewProps {
  ranking: Ranking;
  onTitleChange: (title: string) => void;
  onSave: (id: number, entries: string[]) => void;
  onBack: () => void;
}

const listVariants = {
  hidden: {},
  visible: {
    transition: {
      staggerChildren: 0.055,
      delayChildren: 0.1,
    },
  },
};

const rowVariants = {
  hidden: { opacity: 0, x: -44, scale: 0.94, filter: 'blur(8px)' },
  visible: {
    opacity: 1,
    x: 0,
    scale: 1,
    filter: 'blur(0px)',
    transition: spotlightTransition,
  },
};

export const DetailView: React.FC<DetailViewProps> = ({ ranking, onTitleChange, onSave, onBack }) => {
  const [entries, setEntries] = useState<string[]>(['', '', '', '', '']);
  const [isEditingTitle, setIsEditingTitle] = useState(false);
  const titleInputRef = useRef<HTMLInputElement>(null);
  const [isSaving, setIsSaving] = useState(false);
  const saveTimeoutRef = useRef<number | null>(null);

  useEffect(() => {
    setEntries(ranking.entries);
  }, [ranking]);

  useEffect(() => {
    if (!isEditingTitle) {
      return;
    }

    titleInputRef.current?.focus();
    titleInputRef.current?.select();
  }, [isEditingTitle]);

  useEffect(() => {
    return () => {
      if (saveTimeoutRef.current !== null) {
        window.clearTimeout(saveTimeoutRef.current);
      }
    };
  }, []);

  const handleInputChange = (index: number, value: string) => {
    setEntries(prevEntries =>
      prevEntries.map((entry, entryIndex) => entryIndex === index ? value : entry)
    );
  };

  const handleTitleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
    if (event.key === 'Enter' || event.key === 'Escape') {
      event.preventDefault();
      setIsEditingTitle(false);
    }
  };

  const handleSaveClick = () => {
    if (isSaving) {
      return;
    }

    setIsSaving(true);
    saveTimeoutRef.current = window.setTimeout(() => {
      onSave(ranking.id, entries);
    }, 320);
  };

  return (
    <div className="relative w-full max-w-3xl mx-auto flex flex-col items-center">
      <motion.div
        className="pointer-events-none absolute inset-x-[-18%] top-[-6rem] h-48 rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.2),rgba(255,100,196,0.08)_42%,transparent_72%)] blur-3xl"
        initial={{ opacity: 0, scale: 0.8 }}
        animate={{ opacity: [0.18, 0.46, 0.28], scale: [0.92, 1.06, 1] }}
        transition={{ duration: 2.2, ease: easeOutQuart, repeat: Infinity, repeatType: 'mirror' }}
      />
      <header className="w-full text-center mb-12">
        <AnimatePresence mode="wait" initial={false}>
          {isEditingTitle ? (
            <motion.input
              key="title-input"
              ref={titleInputRef}
              type="text"
              value={ranking.fullTitle}
              onChange={(event) => onTitleChange(event.target.value)}
              onBlur={() => setIsEditingTitle(false)}
              onKeyDown={handleTitleKeyDown}
              className="w-full bg-transparent px-3 py-1 text-center text-5xl font-bold text-white outline-none placeholder-white/30 focus:ring-2 focus:ring-cyan-400 sm:text-7xl"
              placeholder="Titolo classifica"
              initial={{ opacity: 0, y: 8, scale: 0.99 }}
              animate={{ opacity: 1, y: 0, scale: 1 }}
              exit={{ opacity: 0, y: -6, scale: 0.99 }}
              transition={quickTransition}
            />
          ) : (
            <motion.h1
              key="title-display"
              className="cursor-text text-5xl font-black text-gray-900 drop-shadow-[0_0_28px_rgba(34,211,238,0.34)] dark:text-white sm:text-7xl"
              title="Doppio click per modificare"
              onDoubleClick={() => setIsEditingTitle(true)}
              initial={{ opacity: 0, y: 18, scale: 0.92, filter: 'blur(8px)' }}
              animate={{ opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' }}
              exit={{ opacity: 0, y: -8, scale: 0.98 }}
              transition={spotlightTransition}
            >
              {ranking.fullTitle || 'Titolo classifica'}
            </motion.h1>
          )}
        </AnimatePresence>
        <motion.div
          className="mx-auto mt-5 h-px w-32 bg-cyan-300/80 shadow-[0_0_22px_rgba(34,211,238,0.82)]"
          initial={{ opacity: 0, scaleX: 0 }}
          animate={{ opacity: [0, 1, 0.72], scaleX: [0, 1.22, 1] }}
          transition={{ duration: 0.74, ease: easeOutQuart, delay: 0.08 }}
        />
      </header>
      
      <motion.main
        className="w-full flex flex-col space-y-5"
        variants={listVariants}
        initial="hidden"
        animate="visible"
      >
        {entries.map((entry, index) => (
          <motion.div key={index} className="flex items-center space-x-4 w-full" variants={rowVariants}>
            <motion.span
              className="w-10 text-center text-5xl font-black text-cyan-500 drop-shadow-[0_0_16px_rgba(34,211,238,0.54)] dark:text-cyan-400"
              initial={{ opacity: 0, scale: 0.62, rotate: -8 }}
              animate={{ opacity: 1, scale: [0.62, 1.18, 1], rotate: 0 }}
              transition={{ duration: 0.58, ease: easeOutQuart, delay: 0.12 + index * 0.045 }}
            >
              {index + 1}
            </motion.span>
            <motion.div
              className="relative flex-1 overflow-hidden rounded-lg"
              whileFocus={{ scale: 1.01 }}
              transition={quickTransition}
            >
              <input
                type="text"
                value={entry}
                onChange={(e) => handleInputChange(index, e.target.value)}
                placeholder={`Posizione #${index + 1}`}
                className="w-full rounded-lg border-2 border-gray-300 bg-gray-200 p-6 text-2xl text-gray-900 placeholder-gray-500 transition-all duration-200 focus:border-cyan-400 focus:outline-none focus:ring-4 focus:ring-cyan-500/70 dark:border-cyan-950/80 dark:bg-gray-900/82 dark:text-white"
              />
              <motion.span
                className="pointer-events-none absolute left-0 right-0 top-0 h-px bg-cyan-200/90 shadow-[0_0_18px_rgba(34,211,238,0.86)]"
                initial={{ opacity: 0, x: '-100%' }}
                animate={{ opacity: [0, 1, 0], x: '100%' }}
                transition={{ duration: 0.7, ease: easeOutQuart, delay: 0.14 + index * 0.07 }}
              />
              <motion.span
                className="pointer-events-none absolute inset-0 rounded-lg bg-[linear-gradient(110deg,transparent_8%,rgba(255,255,255,0.12)_36%,transparent_62%)]"
                initial={{ x: '-120%' }}
                animate={{ x: '120%' }}
                transition={{ duration: 0.74, ease: easeOutQuart, delay: 0.18 + index * 0.08 }}
              />
            </motion.div>
          </motion.div>
        ))}
      </motion.main>

      <footer className="w-full flex items-center justify-between mt-16 space-x-4">
        <motion.button
          onClick={onBack}
          className="px-12 py-5 text-xl bg-gray-300 dark:bg-gray-700 text-gray-800 dark:text-white font-semibold rounded-lg hover:bg-gray-400 dark:hover:bg-gray-600 focus:outline-none focus:ring-4 focus:ring-gray-500 focus:ring-opacity-50 transition-colors duration-200"
          whileHover={{ scale: 1.03 }}
          whileTap={{ scale: 0.98 }}
          transition={gameShowSpring}
        >
          Indietro
        </motion.button>
        <motion.button
          onClick={handleSaveClick}
          disabled={isSaving}
          className="relative overflow-hidden px-12 py-5 bg-cyan-600 text-white font-bold text-2xl rounded-lg shadow-lg shadow-cyan-500/30 dark:shadow-cyan-900/50 hover:bg-cyan-500 focus:outline-none focus:ring-4 focus:ring-cyan-500 focus:ring-opacity-50 transition-colors duration-200 disabled:cursor-wait"
          animate={isSaving ? { scale: [1, 0.96, 1.08], boxShadow: ['0 0 24px rgba(34,211,238,0.3)', '0 0 58px rgba(34,211,238,0.82)', '0 0 38px rgba(255,100,196,0.42)'] } : { scale: 1 }}
          whileHover={isSaving ? undefined : { scale: 1.045, y: -2 }}
          whileTap={isSaving ? undefined : { scale: 0.98 }}
          transition={gameShowSpring}
        >
          <AnimatePresence>
            {isSaving && (
              <motion.span
                className="pointer-events-none absolute inset-0 rounded-lg border border-cyan-100/80"
                initial={{ opacity: 0.9, scale: 0.96 }}
                animate={{ opacity: 0, scale: 1.18 }}
                exit={{ opacity: 0 }}
                transition={broadcastTransition}
              />
            )}
          </AnimatePresence>
          Salva Classifica
        </motion.button>
      </footer>
    </div>
  );
};
