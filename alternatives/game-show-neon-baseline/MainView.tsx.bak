import React, { useEffect, useRef, useState } from 'react';
import { AnimatePresence, motion } from 'motion/react';
import { Ranking, RankingBox } from '../types';
import { Logo } from './Logo';
import { MainSettingsMenu } from './MainSettingsMenu';
import { broadcastTransition, easeOutQuart, gameShowSpring, quickTransition, screenTransition, spotlightTransition } from '../motionConfig';

interface MainViewProps {
  guestName: string;
  guestNameSize: number;
  setGuestName: (name: string) => void;
  setGuestNameSize: (size: number) => void;
  rankings: Ranking[];
  rankingBoxes: RankingBox[];
  onRankingMetaChange: (id: number, field: 'fullTitle' | 'keyword', value: string) => void;
  onSelectRanking: (boxId: number) => void;
  onLogoClick: () => void;
}

const gridVariants = {
  hidden: {},
  visible: {
    transition: {
      staggerChildren: 0.09,
      delayChildren: 0.12,
    },
  },
};

const bubbleVariants = {
  hidden: { opacity: 0, y: 36, scale: 0.72, rotate: -5, filter: 'blur(10px)' },
  visible: {
    opacity: 1,
    y: 0,
    scale: 1,
    rotate: 0,
    filter: 'blur(0px)',
    transition: spotlightTransition,
  },
};

const bubbleStateVariants = {
  idle: { opacity: 1, scale: 1, y: 0, filter: 'saturate(1) brightness(1)' },
  selected: { opacity: 1, scale: 1.12, y: -10, filter: 'saturate(1.35) brightness(1.2)' },
  dimmed: { opacity: 0.2, scale: 0.92, y: 8, filter: 'saturate(0.35) brightness(0.62) blur(1px)' },
};

const broadcastDelays = [0, 0.1, 0.2];

const selectionSweepTransition = {
  duration: 0.72,
  ease: easeOutQuart,
};

const stageLights = [
  { left: '6%', rotate: -26, color: 'rgba(34,211,238,0.22)', delay: 0 },
  { left: '50%', rotate: 0, color: 'rgba(255,255,255,0.11)', delay: 0.08 },
  { left: '94%', rotate: 26, color: 'rgba(255,100,196,0.18)', delay: 0.16 },
];

const Bubble: React.FC<{
  box: RankingBox;
  isDimmed: boolean;
  isInteractionLocked: boolean;
  isSelected: boolean;
  onSelect: (boxId: number) => void;
}> = ({ box, isDimmed, isInteractionLocked, isSelected, onSelect }) => {
  const baseClasses = "group relative isolate w-full aspect-square rounded-full flex flex-col items-center justify-center overflow-hidden p-4 text-center cursor-pointer focus:outline-none focus:ring-4 focus:ring-offset-2 focus:ring-offset-black";
  const animationDelay = `${box.boxId * 200}ms`;
  const ranking = box.ranking;
  const visualState = isSelected ? 'selected' : isDimmed ? 'dimmed' : 'idle';
  const handleClick = () => {
    if (isInteractionLocked) {
      return;
    }

    onSelect(box.boxId);
  };
  const broadcastRings = (
    <AnimatePresence>
      {isSelected &&
        broadcastDelays.map(delay => (
          <motion.span
            key={delay}
            className="pointer-events-none absolute inset-[-22%] rounded-full border-2 border-cyan-100/90 shadow-[0_0_34px_rgba(34,211,238,0.56),0_0_70px_rgba(255,100,196,0.24)]"
            initial={{ opacity: 0.86, scale: 0.62 }}
            animate={{ opacity: 0, scale: 2.15 }}
            exit={{ opacity: 0 }}
            transition={{ duration: 0.72, ease: easeOutQuart, delay }}
          />
        ))}
    </AnimatePresence>
  );

  if (ranking?.completed) {
    const keyword = ranking.keyword;
    let fontSizeClass = 'text-2xl sm:text-4xl';
    if (keyword.length > 5) fontSizeClass = 'text-xl sm:text-3xl';
    if (keyword.length > 8) fontSizeClass = 'text-lg sm:text-2xl';
    if (keyword.length > 12) fontSizeClass = 'text-base sm:text-xl';

    return (
      <motion.div
        layout
        variants={bubbleVariants}
        style={{ animationDelay }}
      >
        <motion.button
          type="button"
          aria-label={`Apri ${ranking.keyword}`}
          onClick={handleClick}
          className={`${baseClasses} bg-gradient-to-br from-cyan-500 to-cyan-700 border-2 border-cyan-500 shadow-lg shadow-cyan-600/30 focus:ring-cyan-500`}
          variants={bubbleStateVariants}
          animate={visualState}
          transition={gameShowSpring}
          layout
          whileHover={isInteractionLocked ? undefined : { scale: 1.07, y: -7, rotate: -1 }}
          whileTap={isInteractionLocked ? undefined : { scale: 0.97 }}
        >
          <motion.span
            className="pointer-events-none absolute inset-[-5px] rounded-full bg-[conic-gradient(from_90deg,transparent_0deg,rgba(255,255,255,0.86)_52deg,rgba(255,100,196,0.5)_86deg,transparent_142deg,transparent_360deg)] opacity-0 blur-[1px]"
            initial={false}
            animate={isSelected ? { opacity: [0, 0.78, 0], rotate: [0, 220, 420] } : { opacity: 0, rotate: 0 }}
            transition={selectionSweepTransition}
          />
          <span className="pointer-events-none absolute inset-0 rounded-full bg-[radial-gradient(circle_at_50%_22%,rgba(255,255,255,0.36),transparent_42%)] opacity-70" />
          <motion.span
            className="pointer-events-none absolute inset-[12%] rounded-full border border-white/20"
            initial={{ opacity: 0, scale: 0.78 }}
            animate={{ opacity: [0, 0.7, 0], scale: [0.78, 1.15, 1.38] }}
            transition={{ duration: 0.9, ease: easeOutQuart, delay: 0.18 }}
          />
          <motion.h3
            key={ranking.keyword}
            className={`${fontSizeClass} font-bold text-white break-words drop-shadow-[0_0_16px_rgba(255,255,255,0.35)]`}
            initial={{ opacity: 0, y: 18, scale: 0.84, rotate: -2 }}
            animate={{ opacity: 1, y: 0, scale: [0.84, 1.12, 1], rotate: 0 }}
            transition={{ duration: 0.62, ease: easeOutQuart, delay: 0.06 }}
            style={{ WebkitTextStroke: '3px black', paintOrder: 'stroke fill' }}
          >
            {ranking.keyword}
          </motion.h3>
          {broadcastRings}
        </motion.button>
      </motion.div>
    );
  }

  return (
    <motion.div
      layout
      variants={bubbleVariants}
      style={{ animationDelay }}
    >
      <motion.button
        type="button"
        aria-label={`Apri casella ${box.boxId}`}
        onClick={handleClick}
        className={`${baseClasses} bg-gray-800/50 backdrop-blur-sm border-2 border-gray-500 hover:border-cyan-400 hover:bg-gray-700/50 focus:ring-cyan-400`}
        variants={bubbleStateVariants}
        animate={visualState}
        transition={gameShowSpring}
        layout
        whileHover={isInteractionLocked ? undefined : { scale: 1.07, y: -7, rotate: -1 }}
        whileTap={isInteractionLocked ? undefined : { scale: 0.97 }}
      >
        <motion.span
          className="pointer-events-none absolute inset-[-35%] rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.42),transparent_58%)] opacity-0 blur-xl"
          initial={false}
          animate={isSelected ? { opacity: [0, 0.9, 0.28], scale: [0.7, 1.15, 1.02] } : { opacity: 0, scale: 0.85 }}
          transition={{ duration: 0.62, ease: easeOutQuart }}
        />
        <motion.span
          className="pointer-events-none absolute inset-[-1px] rounded-full border border-cyan-200/0 shadow-[0_0_0_rgba(34,211,238,0)]"
          initial={false}
          animate={
            isSelected
              ? {
                  borderColor: 'rgba(165, 243, 252, 0.82)',
                  boxShadow: '0 0 34px rgba(34, 211, 238, 0.42)',
                }
              : {
                  borderColor: 'rgba(165, 243, 252, 0)',
                  boxShadow: '0 0 0 rgba(34, 211, 238, 0)',
                }
          }
          transition={quickTransition}
        />
        <span className="pointer-events-none absolute inset-0 rounded-full bg-cyan-300/0 transition-colors duration-150 group-hover:bg-cyan-300/5" />
        <span className="pointer-events-none absolute inset-[10%] rounded-full border border-white/5" />
        <motion.span
          className="pointer-events-none absolute inset-0 rounded-full bg-[linear-gradient(110deg,transparent_18%,rgba(255,255,255,0.22)_42%,transparent_64%)]"
          animate={isSelected ? { x: ['-120%', '120%'] } : { x: '-120%' }}
          transition={{ duration: 0.46, ease: easeOutQuart }}
        />
        <motion.h2
          className="text-5xl font-black text-gray-400 drop-shadow-[0_0_18px_rgba(34,211,238,0)] sm:text-7xl"
          animate={isSelected ? { color: '#e0faff', textShadow: '0 0 24px rgba(34,211,238,0.72)' } : { color: '#9ca3af', textShadow: '0 0 0 rgba(34,211,238,0)' }}
          transition={quickTransition}
        >
          {box.boxId}
        </motion.h2>
        {broadcastRings}
      </motion.button>
    </motion.div>
  );
};


export const MainView: React.FC<MainViewProps> = ({
  guestName,
  guestNameSize,
  setGuestName,
  setGuestNameSize,
  rankings,
  rankingBoxes,
  onRankingMetaChange,
  onSelectRanking,
  onLogoClick
}) => {
  const [selectedBoxId, setSelectedBoxId] = useState<number | null>(null);
  const [isSettingsOpen, setIsSettingsOpen] = useState(false);
  const selectTimeoutRef = useRef<number | null>(null);
  const guestNameScale = guestNameSize / 100;

  useEffect(() => {
    return () => {
      if (selectTimeoutRef.current !== null) {
        window.clearTimeout(selectTimeoutRef.current);
      }
    };
  }, []);

  const handleSelectBox = (boxId: number) => {
    if (selectedBoxId !== null) {
      return;
    }

    setSelectedBoxId(boxId);
    selectTimeoutRef.current = window.setTimeout(() => {
      onSelectRanking(boxId);
    }, 620);
  };

  return (
    <div className="relative w-full h-full flex flex-col items-center justify-center py-8">
      <div className="pointer-events-none absolute inset-x-[-8%] top-[18%] z-0 h-[72%] overflow-hidden [mask-image:radial-gradient(ellipse_at_center,black_0%,black_58%,transparent_82%)]">
        {stageLights.map((light) => (
          <motion.div
            key={`${light.left}-${light.rotate}`}
            className="absolute top-[-10%] h-[118%] w-[26%] origin-top rounded-b-full blur-3xl mix-blend-screen"
            style={{
              left: light.left,
              background: `radial-gradient(ellipse at top, ${light.color}, transparent 68%)`,
              transform: `translateX(-50%) rotate(${light.rotate}deg)`,
            }}
            initial={{ opacity: 0, scaleY: 0.6, scaleX: 0.8 }}
            animate={{ opacity: [0.04, 0.36, 0.18], scaleY: [0.72, 1.05, 0.92], scaleX: [0.78, 1.04, 0.88] }}
            transition={{
              duration: 2.6,
              ease: easeOutQuart,
              repeat: Infinity,
              repeatType: 'mirror',
              delay: light.delay,
            }}
          />
        ))}
        <motion.div
          className="absolute left-1/2 top-[54%] h-56 w-[82%] -translate-x-1/2 rounded-full bg-cyan-400/8 blur-3xl"
          animate={{ opacity: [0.1, 0.28, 0.16], scale: [0.94, 1.05, 1] }}
          transition={{ duration: 2.1, ease: easeOutQuart, repeat: Infinity, repeatType: 'mirror' }}
        />
      </div>

      <motion.button
        type="button"
        aria-label="Apri impostazioni"
        title="Impostazioni"
        onClick={() => setIsSettingsOpen(true)}
        className="absolute right-0 top-0 z-40 flex h-12 w-12 items-center justify-center rounded-md border border-cyan-300/0 bg-black/0 text-cyan-100 opacity-0 shadow-[0_0_22px_rgba(34,211,238,0)] backdrop-blur transition-all duration-150 hover:border-cyan-300/35 hover:bg-black/55 hover:opacity-100 hover:shadow-[0_0_22px_rgba(34,211,238,0.18)] focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-cyan-300"
        whileHover={{ scale: 1.04 }}
        whileTap={{ scale: 0.96 }}
        transition={quickTransition}
      >
        <svg
          aria-hidden="true"
          className="h-5 w-5"
          fill="none"
          stroke="currentColor"
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth="2"
          viewBox="0 0 24 24"
        >
          <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" />
          <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .9l-.03.08a2 2 0 0 1-3.76 0l-.03-.08a1.7 1.7 0 0 0-1-.9 1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.9-1l-.08-.03a2 2 0 0 1 0-3.76l.08-.03a1.7 1.7 0 0 0 .9-1 1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.9l.03-.08a2 2 0 0 1 3.76 0l.03.08a1.7 1.7 0 0 0 1 .9 1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.33.12.65.42.9 1l.08.03a2 2 0 0 1 0 3.76l-.08.03a1.7 1.7 0 0 0-.9 1Z" />
        </svg>
      </motion.button>

      <AnimatePresence>
        {isSettingsOpen && (
          <MainSettingsMenu
            guestNameSize={guestNameSize}
            onClose={() => setIsSettingsOpen(false)}
            onGuestNameSizeChange={setGuestNameSize}
            onRankingMetaChange={onRankingMetaChange}
            rankings={rankings}
          />
        )}
      </AnimatePresence>

      <motion.div
        onClick={onLogoClick}
        className="z-10 w-full max-w-[min(52rem,76vh)] cursor-pointer px-4 drop-shadow-[0_0_30px_rgba(34,211,238,0.24)]"
        initial={{ opacity: 0, y: -12, scale: 0.985 }}
        animate={{ opacity: 1, y: 0, scale: 1 }}
        transition={{ ...screenTransition, delay: 0.04 }}
        whileHover={{ scale: 1.012 }}
        whileTap={{ opacity: 0.84 }}
      >
        <Logo />
      </motion.div>
      
      <motion.header
        className="z-20 mt-2 mb-8 w-full sm:mb-10"
        initial={{ opacity: 0, y: 10 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ ...screenTransition, delay: 0.1 }}
      >
         <input
            type="text"
            value={guestName}
            onChange={(e) => setGuestName(e.target.value)}
            className="w-full bg-transparent text-white placeholder-gray-400 text-4xl sm:text-7xl lg:text-8xl xl:text-9xl leading-none font-black text-center py-3 px-6 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:rounded-lg transition-all"
            style={{
              fontSize: `clamp(${2.25 * guestNameScale}rem, ${8 * guestNameScale}vh, ${7 * guestNameScale}rem)`,
            }}
            placeholder="Nome Ospite"
        />
      </motion.header>
      
      <motion.main
        className="relative z-10 mx-auto grid w-full max-w-6xl grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-8 lg:grid-cols-5"
        variants={gridVariants}
        initial="hidden"
        animate="visible"
        layout
      >
        <AnimatePresence>
          {selectedBoxId !== null && (
            <motion.div
              className="pointer-events-none absolute inset-[-12%] -z-10 rounded-full bg-[radial-gradient(circle,rgba(34,211,238,0.34),rgba(255,100,196,0.14)_42%,transparent_70%)] blur-2xl"
              initial={{ opacity: 0, scale: 0.72 }}
              animate={{ opacity: [0, 0.96, 0.18], scale: [0.72, 1.22, 1.05] }}
              exit={{ opacity: 0 }}
              transition={{ duration: 0.72, ease: easeOutQuart }}
            />
          )}
        </AnimatePresence>
        {rankingBoxes.map((box) => (
          <Bubble
            key={box.boxId}
            box={box}
            isDimmed={selectedBoxId !== null && selectedBoxId !== box.boxId}
            isInteractionLocked={selectedBoxId !== null}
            isSelected={selectedBoxId === box.boxId}
            onSelect={handleSelectBox}
          />
        ))}
      </motion.main>
    </div>
  );
};
