@import "tailwindcss";

@source "./*.tsx";
@source "./components/**/*.tsx";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  /* Font dei testi grandi. Variante A provata e scartata: "Big Shoulders Display" (Google Fonts). */
  --font-display: var(--font-sans);
  --animate-float-slow: float 6s ease-in-out infinite;
  --animate-float-fast: float 5s ease-in-out infinite;
  --animate-fade-in: fade-in 350ms ease-out both;

  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(3deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}

@keyframes moveHorizontal {
  0% {
    transform: translateX(-50%) translateY(-10%);
  }
  50% {
    transform: translateX(50%) translateY(10%);
  }
  100% {
    transform: translateX(-50%) translateY(-10%);
  }
}

@keyframes moveInCircle {
  0% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(180deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes moveVertical {
  0% {
    transform: translateY(-50%);
  }
  50% {
    transform: translateY(50%);
  }
  100% {
    transform: translateY(-50%);
  }
}

.gimme-gradient-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: linear-gradient(
    40deg,
    var(--gradient-background-start),
    var(--gradient-background-end)
  );
  pointer-events: none;
}

.gimme-gradient-background::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 50%, transparent 0%, transparent 36%, rgba(0, 0, 0, 0.48) 100%),
    linear-gradient(90deg, rgba(0, 0, 0, 0.62), transparent 28%, transparent 72%, rgba(0, 0, 0, 0.62));
}

.gimme-gradients-container {
  position: absolute;
  inset: -10%;
  width: 120%;
  height: 120%;
  filter: url(#gimme-gradient-blur) blur(38px);
  opacity: 0.26;
}

.gimme-gradient-orb,
.gimme-gradient-pointer {
  position: absolute;
  width: var(--gradient-size);
  height: var(--gradient-size);
  top: calc(50% - var(--gradient-size) / 2);
  left: calc(50% - var(--gradient-size) / 2);
  mix-blend-mode: var(--blending-value);
  border-radius: 9999px;
  transform-origin: center center;
}

.gimme-gradient-first {
  background: radial-gradient(circle at center, rgba(var(--first-color), 0.62) 0, rgba(var(--first-color), 0) 48%) no-repeat;
  animation: moveVertical 68s ease infinite;
}

.gimme-gradient-second {
  background: radial-gradient(circle at center, rgba(var(--second-color), 0.54) 0, rgba(var(--second-color), 0) 50%) no-repeat;
  transform-origin: calc(50% - 360px);
  animation: moveInCircle 56s reverse infinite;
}

.gimme-gradient-third {
  background: radial-gradient(circle at center, rgba(var(--third-color), 0.42) 0, rgba(var(--third-color), 0) 50%) no-repeat;
  transform-origin: calc(50% + 340px);
  animation: moveInCircle 96s linear infinite;
}

.gimme-gradient-fourth {
  background: radial-gradient(circle at center, rgba(var(--fourth-color), 0.5) 0, rgba(var(--fourth-color), 0) 50%) no-repeat;
  transform-origin: calc(50% - 200px);
  animation: moveHorizontal 88s ease infinite;
  opacity: 0.75;
}

.gimme-gradient-fifth {
  background: radial-gradient(circle at center, rgba(var(--fifth-color), 0.16) 0, rgba(var(--fifth-color), 0) 42%) no-repeat;
  transform-origin: calc(50% - 720px) calc(50% + 720px);
  animation: moveInCircle 68s ease infinite;
  opacity: 0.48;
}

.gimme-gradient-pointer {
  width: 100%;
  height: 100%;
  top: -50%;
  left: -50%;
  background: radial-gradient(circle at center, rgba(var(--pointer-color), 0.42) 0, rgba(var(--pointer-color), 0) 44%) no-repeat;
  opacity: 0.45;
}

/* ---------- Liquid Glass ----------
   Buio profondo, tre grandi luci colorate che derivano lente, lastre di vetro spesso che le rifrangono
   (components/Glass.tsx). Tipografia: Inter Tight, bianco puro. Essenziale: vetro, luce, testo. */

:root {
  --lg-bg: #04050a;
  --lg-ink: #ffffff;
  --lg-cyan: #00d0ff;
  --lg-pink: #ff64c4;
  --lg-violet: #7c5cff;
}

.font-tight {
  font-family: "Inter Tight", var(--font-sans);
}

.lg-field {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: var(--lg-bg);
}

.lg-light {
  position: absolute;
  width: 62vmax;
  height: 62vmax;
  border-radius: 9999px;
  filter: blur(90px) saturate(0.85);
  opacity: 0.24;
  transition: opacity 1.2s ease, filter 1.2s ease;
  will-change: transform;
}

.lg-light-cyan {
  left: -14vmax;
  top: -18vmax;
  background: radial-gradient(circle, var(--lg-cyan) 0%, rgba(0, 208, 255, 0.35) 38%, transparent 66%);
  animation: lg-drift-a 70s ease-in-out infinite alternate;
}

.lg-light-pink {
  right: -16vmax;
  bottom: -22vmax;
  background: radial-gradient(circle, var(--lg-pink) 0%, rgba(255, 100, 196, 0.35) 38%, transparent 66%);
  animation: lg-drift-b 84s ease-in-out infinite alternate;
}

.lg-light-violet {
  left: 30vmax;
  top: 20vmax;
  width: 44vmax;
  height: 44vmax;
  opacity: 0.16;
  background: radial-gradient(circle, var(--lg-violet) 0%, rgba(124, 92, 255, 0.3) 40%, transparent 68%);
  animation: lg-drift-c 60s ease-in-out infinite alternate;
}

/* Increspature: cerchi sottilissimi che si allargano dal centro come una goccia nell'acqua.
   Sono la "trama" che il vetro piega: senza qualcosa di nitido dietro, la rifrazione non si vedrebbe. */
@property --ripple {
  syntax: "<length>";
  inherits: false;
  initial-value: 0px;
}

.lg-field::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: radial-gradient(ellipse 70% 65% at 50% 55%, transparent 40%, rgba(4, 5, 10, 0.75) 100%);
}

.lg-field::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-radial-gradient(
    circle at 50% 62%,
    rgba(255, 255, 255, 0.07) var(--ripple),
    rgba(255, 255, 255, 0.07) calc(var(--ripple) + 1.5px),
    transparent calc(var(--ripple) + 2.5px),
    transparent calc(var(--ripple) + 84px)
  );
  -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 62%, #000 20%, transparent 100%);
  mask-image: radial-gradient(ellipse 75% 70% at 50% 62%, #000 20%, transparent 100%);
  animation: lg-ripple 12s linear infinite;
}

@keyframes lg-ripple {
  from { --ripple: 0px; }
  to { --ripple: 84px; }
}

.lg-surge .lg-field::after {
  animation-duration: 4s;
}

@keyframes lg-drift-a { to { transform: translate(38vmax, 26vmax) scale(1.15); } }
@keyframes lg-drift-b { to { transform: translate(-42vmax, -24vmax) scale(0.9); } }
@keyframes lg-drift-c { to { transform: translate(-26vmax, 18vmax) scale(1.2); } }

/* Salvataggio: le luci si accendono a piena potenza dietro il vetro. */
.lg-surge .lg-light {
  opacity: 0.5;
  filter: blur(80px) saturate(1);
}

/* Lastra di vetro: limpida, niente velo lattiginoso. Solo luce: una lucentezza morbida che scende dall'alto,
   un riflesso netto sul bordo alto, un riflesso caldo sul bordo basso (la luce che attraversa lo spessore). */
/* Niente "position" qui: una regola fuori dai layer di Tailwind vincerebbe su "fixed"/"absolute" delle lastre
   (il pannello impostazioni finiva in mezzo alla pagina). Il posizionamento lo decide Glass.tsx. */
.lg-glass {
  isolation: isolate;
  background:
    radial-gradient(circle at var(--lx, 50%) var(--ly, -30%), rgba(255, 255, 255, 0.09), transparent 60%),
    radial-gradient(120% 70% at 50% 0%, rgba(255, 255, 255, 0.06), transparent 70%);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.5),
    inset 0 -1px 0 rgba(255, 255, 255, 0.14),
    inset 0 -24px 40px -32px rgba(255, 255, 255, 0.16),
    0 30px 60px -30px rgba(0, 0, 0, 0.9);
}

/* Bordo che cattura la luce: più brillante in alto a sinistra, come uno spigolo smussato. */
.lg-glass::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 1.5px;
  border-radius: inherit;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.04) 30%, rgba(255, 255, 255, 0) 60%, rgba(255, 255, 255, 0.3));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.lg-text-glow {
  text-shadow: 0 0 0.35em rgba(255, 255, 255, 0.25), 0 0.04em 0.12em rgba(0, 0, 0, 0.35);
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  background: #000;
  font-family: var(--font-sans);
}

.app-safe-center {
  justify-content: flex-start;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
